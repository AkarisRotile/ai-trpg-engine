# ── 运行期数据（每个人跑出来的东西，绝不进仓库）──
data/players/
data/memory/
data/runtime/
data/exports/
data/config.json
data/config.json.*
data/roster.yaml
data/rules/glossary_extra.yaml
data/rules/full/
data/.webview/
data/sheet_map.txt
data/sheet_person.txt
data/defined_names.txt

