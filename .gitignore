build/
dist/
*.spec
assets/_exe_icon_check.png

# ── 自检临时目录 ──
.selftest/
.cache/
tmp/

# ── 虚拟环境 ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

