# ── 运行期数据（每个人跑出来的东西，绝不进仓库）──
data/players/
data/memory/
data/runtime/
data/exports/
data/config.json
data/config.json.*
data/roster.yaml
data/rules/glossary_extra.yaml
data/rules/full/
data/.webview/
data/.webview-smoke/
data/.ui-version
data/studies/
data/sheet_map.txt
data/sheet_person.txt
data/defined_names.txt

# ── 用户自己放的模组（可能有版权，也可能是私活）──
# 仓库里只保留内置的演示模组
data/modules/*
!data/modules/demo_洋馆之夜/

# ── 插件 ──
# 两个内置插件跟着仓库走；用户自己装的插件一律不跟踪。
# 同一件事可以有好几个插件做，里面有别人的东西。
data/plugins/*
!data/plugins/thinking-viewer/
!data/plugins/battle-grid/
# 插件的启停状态是本地的东西，不进库
data/plugins.json

# ── 用户自己放的立绘和头像 ──
data/portraits/

# ── 打包产物 ──
build/
dist/
*.spec
assets/_exe_icon_check.png
assets/_exe_icon_big.png
# 打包好之后装在根目录的那份程序
COC跑团引擎.exe
_internal/
读我.txt
_smoke_exe_result.json

# ── 自检临时目录 ──
.selftest/
.cache/
tmp/

# ── 虚拟环境 ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── 版权材料：规则书是正式出版物的中文译本，不进仓库 ──
克苏鲁的呼唤第七版*.pdf
*.pdf
!data/modules/**/*.pdf
# 根目录那张空白卡是本地原件，仓库里只保留 data/templates/ 下的那份
COC7空白卡CY22.4 Plus.xlsx

